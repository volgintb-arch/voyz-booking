# Your server's domain, e.g. api.voyz.kg (its DNS A-record points to this VPS).
API_DOMAIN=api.voyz.kg
# Database password: long and random.
DB_PASSWORD=
# 32+ random characters; encrypts owners' Aynes keys. Never change after launch.
SERVER_SECRET=
# Random string for the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# The guest app address (GitHub Pages now, your domain later).
APP_URL=https://volgintb-arch.github.io/voyz-booking/
CORS_ORIGINS=https://volgintb-arch.github.io,capacitor://localhost,http://localhost,https://localhost
AYNES_API_URL=https://aynes.pro
# Real hosts: false. true only for demo servers.
ALLOW_DEV_LOGIN=false
RUN_WORKERS=true
