# Postgres connection (Render/Neon/VPS). Required.
DATABASE_URL=postgres://voyz:voyz@localhost:5432/voyz_dev
# Port the HTTP server listens on.
PORT=8080
# Public address of this API, e.g. https://api.voyz.kg/ — used in iCal links and the bot.
API_URL=http://localhost:8080/
# Public address of the guest web app (share links, redirects from /s/<slug>).
APP_URL=https://volgintb-arch.github.io/voyz-booking/
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=https://volgintb-arch.github.io,http://localhost:5173,capacitor://localhost,http://localhost
# 32+ random characters. Encrypts owners' Aynes keys and signs internal tokens.
SERVER_SECRET=change-me-to-a-long-random-string-0123456789
# Telegram bot from @BotFather. Without it login falls back to dev mode only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram calls POST /api/telegram/webhook/<this>.
TELEGRAM_WEBHOOK_SECRET=
# Aynes API base address.
AYNES_API_URL=https://aynes.pro
# Demo only: allows "Войти как демо-хозяин" without Telegram. Never in production.
ALLOW_DEV_LOGIN=false
# Run background jobs (outbox, holds, iCal, morning summary) in this process.
RUN_WORKERS=true
# Sentry error reports (docs/MONITORING.md); empty — off.
SENTRY_DSN=
