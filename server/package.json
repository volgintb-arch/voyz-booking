{
  "name": "voyz-booking-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.3.3",
    "pg": "8.16.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/pg": "8.15.4",
    "esbuild": "0.25.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
